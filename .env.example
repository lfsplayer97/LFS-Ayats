# Environment variables for LFS-Ayats API

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Default: http://localhost:3000,http://localhost:8080
# Example: http://localhost:3000,https://myapp.com,https://api.myapp.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database Configuration
# Uncomment and configure if using PostgreSQL
# DB_PASSWORD=your_secure_password_here

# API Configuration
# Uncomment to customize API settings
# API_HOST=0.0.0.0
# API_PORT=8000
# API_WORKERS=4

# Logging Configuration
# LOG_LEVEL=INFO

# Integration Tokens (Optional)
# Discord webhook URL for notifications
# DISCORD_WEBHOOK_URL=

# Telegram bot token
# TELEGRAM_BOT_TOKEN=

# Cloud backup credentials path
# CLOUD_CREDENTIALS_PATH=./credentials.json
